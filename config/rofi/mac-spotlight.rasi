/*
 * mac-kali — a Spotlight-style rofi theme.
 * Centered, rounded, translucent search bar — bound to Super+Space.
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    icon-theme:                 "WhiteSur";
    display-drun:               "Search";
    drun-display-format:        "{name}";
    font:                       "Inter 13";
}

* {
    bg:      #1e1e1eee;
    fg:      #f2f2f2ff;
    fg-alt:  #a0a0a0ff;
    accent:  #0a84ffff;

    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         north;
    anchor:            north;
    y-offset:          18%;
    width:             640px;
    background-color:  @bg;
    border:            1px;
    border-color:      #ffffff22;
    border-radius:     14px;
    padding:           4px;
}

mainbox {
    background-color: transparent;
    children:          [ inputbar, listview ];
    spacing:           4px;
}

inputbar {
    background-color: transparent;
    text-color:        @fg;
    padding:           14px 18px;
    children:          [ entry ];
}

entry {
    placeholder:       "Spotlight Search";
    placeholder-color: @fg-alt;
    text-color:        @fg;
    font:              "Inter 16";
}

listview {
    background-color: transparent;
    lines:             8;
    scrollbar:         false;
    spacing:           2px;
    padding:           4px 8px 10px 8px;
}

element {
    background-color: transparent;
    text-color:        @fg;
    padding:           8px 10px;
    border-radius:     8px;
}

element selected {
    background-color: @accent;
    text-color:        #ffffff;
}

element-icon {
    size:    22px;
    padding: 0 10px 0 0;
}

element-text {
    vertical-align: 0.5;
}
